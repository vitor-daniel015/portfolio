{
  "name": "vitor-daniel-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc --noEmit && node scripts/check-assets.mjs && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "format": "prettier --write src scripts index.html vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src scripts index.html vite.config.ts tsconfig.json package.json",
    "check:assets": "node scripts/check-assets.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "typescript": "^6.0.3",
    "vite": "^6.2.0"
  },
  "overrides": {
    "tsx": {
      "esbuild": "^0.28.1"
    }
  }
}
